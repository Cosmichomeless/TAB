    "What is on this iPhone now will be deleted. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was sich jetzt auf diesem iPhone befindet, wird gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que hay ahora en este iPhone se borrará. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui se trouve actuellement sur cet iPhone sera supprimé. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che c'è ora su questo iPhone verrà eliminato. Questa azione non può essere annullata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está agora neste iPhone será apagado. Esta ação não pode ser anulada."
          }
        }
      }
    },

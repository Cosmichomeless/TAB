        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saldos são recalculados."
          }
        }
      }
    },
    "The contents of the file do not add up, so nothing was imported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt der Datei stimmt nicht überein, daher wurde nichts importiert."

    "Adds a payment of %@ from %@ to %@, so the balances update.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt eine Zahlung von %1$@ von %2$@ an %3$@ hinzu, damit die Salden aktualisiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un pago de %1$@ de %2$@ a %3$@ para que se actualicen los saldos."
          }
        },
        "fr": {

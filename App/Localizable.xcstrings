    "Changing the amount or participants will replace the existing split with an equal split.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Betrag oder die Teilnehmer änderst, wird die bestehende Aufteilung durch eine gleichmäßige ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cambias el importe o los participantes, el reparto actual se sustituirá por un reparto igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier le montant ou les participants remplacera la répartition actuelle par une répartition égale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiando l'importo o i partecipanti, la divisione attuale verrà sostituita da una divisione uguale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o montante ou os participantes substitui a divisão atual por uma divisão igual."
          }
        }
      }
    },
    "Check the numbers in the split: use positive numbers only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe die Zahlen der Aufteilung: Verwende nur positive Zahlen."
          }
        },
        "es": {

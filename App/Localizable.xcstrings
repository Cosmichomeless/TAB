    "Your group stays as it is and a new one is created.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gruppe bleibt, wie sie ist, und eine neue wird erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu grupo se queda como está y se crea uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre groupe reste tel quel et un nouveau est créé."
          }
        },

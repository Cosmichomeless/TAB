    },
    "Your group uses %@ and this one uses %@, so it cannot be updated.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gruppe verwendet %1$@ und diese %2$@, daher kann sie nicht aktualisiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu grupo usa %1$@ y este usa %2$@, así que no se puede actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre groupe utilise %1$@ et celui-ci utilise %2$@, il ne peut donc pas être mis à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo gruppo usa %1$@ e questo usa %2$@, quindi non può essere aggiornato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu grupo usa %1$@ e este usa %2$@, por isso não pode ser atualizado."
          }
        }
      }
    },
    "Your groups and expenses are stored only on this iPhone. TAB has no accounts and never uploads them. They are included in the backup that iOS makes of your iPhone to iCloud or to your computer, under your own Apple settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gruppen und Ausgaben werden nur auf diesem iPhone gespeichert. TAB hat keine Konten und lädt sie nie hoch. Sie sind im Backup enthalten, das iOS von deinem iPhone in iCloud oder auf deinem Computer anlegt – gemäß deinen eigenen Apple-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus grupos y gastos se guardan solo en este iPhone. TAB no tiene cuentas y nunca los sube a ningún sitio. Se incluyen en la copia de seguridad que iOS hace de tu iPhone en iCloud o en tu ordenador, según tus propios ajustes de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos groupes et dépenses sont enregistrés uniquement sur cet iPhone. TAB n'a pas de comptes et ne les envoie jamais nulle part. Ils sont inclus dans la sauvegarde qu'iOS fait de votre iPhone sur iCloud ou sur votre ordinateur, selon vos propres réglages Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi gruppi e le tue spese sono salvati solo su questo iPhone. TAB non ha account e non li carica mai. Sono inclusi nel backup che iOS fa del tuo iPhone su iCloud o sul computer, secondo le tue impostazioni Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus grupos e despesas ficam guardados apenas neste iPhone. O TAB não tem contas e nunca os envia. Estão incluídos na cópia de segurança que o iOS faz do seu iPhone para o iCloud ou para o computador, de acordo com as suas definições Apple."
          }
        }
      }
    },

    "Pick yourself so the balances show what you owe or are owed. If you skip it, you join the group as a new member.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle dich selbst aus, damit die Salden zeigen, was du schuldest oder bekommst. Wenn du das überspringst, trittst du der Gruppe als neues Mitglied bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elígete para que los saldos muestren lo que debes o te deben. Si lo omites, entrarás al grupo como un miembro nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-vous pour que les soldes indiquent ce que vous devez ou ce qu'on vous doit. Si vous passez cette étape, vous rejoignez le groupe comme nouveau membre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli te stesso così i saldi mostrano quanto devi o ti devono. Se salti questo passaggio, entri nel gruppo come nuovo membro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha-se a si próprio para que os saldos mostrem o que deve ou lhe devem. Se ignorar, entra no grupo como um novo membro."
          }
        }
      }
    },

    },
    "This file was made by a newer version of TAB. Update the app and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde mit einer neueren Version von TAB erstellt. Aktualisiere die App und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo lo creó una versión más reciente de TAB. Actualiza la app e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a été créé par une version plus récente de TAB. Mettez l'app à jour et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è stato creato da una versione più recente di TAB. Aggiorna l'app e riprova."
          }
        },
        "pt": {
